<?php

declare(strict_types = 1);

namespace Drupal\restic_backup\Service;

use Drupal\Core\File\FileSystemInterface;
use Psr\Log\LoggerInterface;
use Symfony\Component\Process\Process;

/**
 * Service for intelligent file discovery and categorization.
 *
 * Analyzes the Drupal project to identify files that should be backed up,
 * using .gitignore rules and Drupal-specific pattern recognition.
 */
class FileDiscoveryService {

  /**
   * Drupal file system service.
   */
  protected FileSystemInterface $fileSystem;

  /**
   * Logger instance.
   */
  protected LoggerInterface $logger;

  /**
   * Drupal project root directory.
   */
  protected string $projectRoot;

  /**
   * Constructs a new FileDiscoveryService instance.
   *
   * @param \Drupal\Core\File\FileSystemInterface $file_system
   *   The Drupal file system service.
   * @param \Psr\Log\LoggerInterface $logger
   *   The logger service.
   */
  public function __construct(
    FileSystemInterface $file_system,
    LoggerInterface $logger
  ) {
    $this->fileSystem = $file_system;
    $this->logger = $logger;
    // Project root is the directory containing web/ folder
    $this->projectRoot = dirname(\Drupal::root());
  }

  /**
   * Scan project and categorize files for backup.
   *
   * @return array
   *   Categorized file structure with metadata.
   *
   * @throws \Exception
   *   If prerequisites (git, .gitignore) not met.
   */
  public function scanProject(): array {
    // Validate prerequisites
    if (!$this->hasGitignore()) {
      throw new \Exception(
        'No .gitignore found in project root. Cannot auto-detect files.'
      );
    }

    if (!$this->gitAvailable()) {
      throw new \Exception(
        'git command not available. Required for .gitignore parsing.'
      );
    }

    $this->logger->debug('Starting file discovery scan of project.');

    // Initialize result structure
    $result = [
      'public_files' => [
        'included' => [],
        'excluded_regenerable' => [],
        'count' => 0,
        'total_size_bytes' => 0,
      ],
      'private_files' => [
        'paths' => [],
        'count' => 0,
        'total_size_bytes' => 0,
        'requires_encryption' => TRUE,
      ],
      'sensitive_config' => [
        'paths' => [],
        'count' => 0,
        'requires_encryption' => TRUE,
      ],
      'dependencies' => [
        'excluded_by_default' => TRUE,
        'count' => 0,
      ],
      'regenerable' => [
        'informational' => [],
        'count' => 0,
      ],
      'metadata' => [
        'gitignore_found' => TRUE,
        'total_candidate_size_bytes' => 0,
        'total_files' => 0,
        'scan_timestamp' => \Drupal::time()->getCurrentTime(),
      ],
    ];

    // Get private files path
    $private_path = $this->getPrivateFilesPath();

    // Scan all files
    $all_files = $this->recursiveFileScan($this->projectRoot);
    $this->logger->info(
      'Found @count total files in project',
      ['@count' => count($all_files)]
    );

    // Categorize each file
    foreach ($all_files as $filepath) {
      $relative_path = str_replace($this->projectRoot . '/', '', $filepath);

      // Check gitignore first (skip ignored files)
      if ($this->isIgnoredByGit($relative_path)) {
        continue;
      }

      $filesize = 0;
      if (is_file($filepath)) {
        $filesize = filesize($filepath);
      }

      // Categorize by type
      if ($this->isDependency($relative_path)) {
        $result['dependencies'][] = $relative_path;
        $result['dependencies']['count']++;
        continue;
      }

      if ($this->isRegenerableFile($relative_path)) {
        $result['regenerable']['informational'][] = [
          'path' => $relative_path,
          'reason' => 'Auto-generated by Drupal (image styles, CSS/JS aggregation, cache)',
          'size' => $filesize,
        ];
        $result['regenerable']['count']++;
        continue;
      }

      if ($this->isSensitiveConfig($relative_path)) {
        $result['sensitive_config']['paths'][] = [
          'path' => $relative_path,
          'type' => $this->getSensitiveConfigType($relative_path),
          'size' => $filesize,
        ];
        $result['sensitive_config']['count']++;
        continue;
      }

      if ($this->isPrivateFile($relative_path, $private_path)) {
        $result['private_files']['paths'][] = [
          'path' => $relative_path,
          'size' => $filesize,
          'human' => $this->formatBytes($filesize),
        ];
        $result['private_files']['total_size_bytes'] += $filesize;
        $result['private_files']['count']++;
        continue;
      }

      if ($this->isPublicFile($relative_path)) {
        $result['public_files']['included'][] = [
          'path' => $relative_path,
          'size' => $filesize,
          'human' => $this->formatBytes($filesize),
        ];
        $result['public_files']['total_size_bytes'] += $filesize;
        $result['public_files']['count']++;
        $result['metadata']['total_candidate_size_bytes'] += $filesize;
        $result['metadata']['total_files']++;
      }
    }

    $this->logger->info(
      'File discovery complete: @public public, @private private, @sensitive sensitive, @deps dependencies, @regen regenerable',
      [
        '@public' => $result['public_files']['count'],
        '@private' => $result['private_files']['count'],
        '@sensitive' => $result['sensitive_config']['count'],
        '@deps' => $result['dependencies']['count'],
        '@regen' => $result['regenerable']['count'],
      ]
    );

    return $result;
  }

  /**
   * Build Restic exclude patterns from file selections.
   *
   * @param array $selections
   *   User's chosen files (paths to include).
   *
   * @return array
   *   Patterns for Restic --exclude flags.
   */
  public function buildExclusionList(array $selections): array {
    $project_scan = $this->scanProject();
    $exclusions = [];

    // Exclude all dependencies
    foreach ($project_scan['dependencies'] as $dep) {
      if (is_string($dep)) {
        $exclusions[] = $dep;
      }
    }

    // Exclude all regenerables
    foreach ($project_scan['regenerable']['informational'] as $regen) {
      $exclusions[] = $regen['path'];
    }

    // Exclude public files NOT in selections
    foreach ($project_scan['public_files']['included'] as $file) {
      if (!in_array($file['path'], $selections)) {
        $exclusions[] = $file['path'];
      }
    }

    // Exclude private files NOT in selections
    foreach ($project_scan['private_files']['paths'] as $file) {
      if (!in_array($file['path'], $selections)) {
        $exclusions[] = $file['path'];
      }
    }

    // Exclude sensitive config NOT in selections
    foreach ($project_scan['sensitive_config']['paths'] as $file) {
      if (!in_array($file['path'], $selections)) {
        $exclusions[] = $file['path'];
      }
    }

    return $exclusions;
  }

  /**
   * Export exclusion patterns to a Restic exclude file.
   *
   * @param array $exclude_patterns
   *   List of patterns to exclude.
   * @param string $path
   *   Path to write the exclude file to.
   */
  public function exportExclusionFile(array $exclude_patterns, string $path): void {
    $content = implode("\n", $exclude_patterns) . "\n";
    file_put_contents($path, $content);
    $this->logger->debug('Wrote @count exclusion patterns to @path', [
      '@count' => count($exclude_patterns),
      '@path' => $path,
    ]);
  }

  // ========== HELPER METHODS ==========

  /**
   * Check if .gitignore exists in project root.
   */
  private function hasGitignore(): bool {
    return file_exists($this->projectRoot . '/.gitignore');
  }

  /**
   * Check if git command is available.
   */
  private function gitAvailable(): bool {
    $process = new Process(['which', 'git']);
    $process->run();
    return $process->getExitCode() === 0;
  }

  /**
   * Check if file is ignored by .gitignore using git check-ignore.
   */
  private function isIgnoredByGit(string $relative_path): bool {
    $process = new Process(
      ['git', 'check-ignore', $relative_path],
      $this->projectRoot
    );
    $process->run();
    return $process->getExitCode() === 0;
  }

  /**
   * Check if path is a dependency directory.
   */
  private function isDependency(string $path): bool {
    $dependencies = [
      'vendor/',
      'node_modules/',
      'web/core/',
      'web/libraries/',
    ];

    foreach ($dependencies as $dep) {
      if (strpos($path, $dep) === 0) {
        return TRUE;
      }
    }
    return FALSE;
  }

  /**
   * Check if path is regenerable (safe to skip/delete).
   */
  private function isRegenerableFile(string $path): bool {
    $regenerables = [
      // Image styles
      'web/sites/default/files/styles/',
      'web/sites/*/files/styles/',
      // Aggregated assets
      'web/sites/default/files/css/',
      'web/sites/*/files/css/',
      'web/sites/default/files/js/',
      'web/sites/*/files/js/',
      // Twig cache
      'web/sites/default/files/php/',
      'web/sites/*/files/php/',
      // Advanced Aggregation
      'web/sites/default/files/advagg',
      'web/sites/*/files/advagg',
    ];

    foreach ($regenerables as $pattern) {
      // Convert glob patterns to regex
      $regex = str_replace(
        ['*', '?'],
        ['.*', '.'],
        preg_quote($pattern, '/')
      );
      if (preg_match("/{$regex}/", $path)) {
        return TRUE;
      }
    }
    return FALSE;
  }

  /**
   * Check if file is sensitive configuration.
   */
  private function isSensitiveConfig(string $path): bool {
    $sensitive_files = [
      'settings.php',
      'settings.local.php',
      'services.yml',
      '.env',
      '.env.local',
    ];

    $filename = basename($path);
    if (in_array($filename, $sensitive_files)) {
      return TRUE;
    }

    // Pattern matching for sensitive files
    $sensitive_patterns = [
      '*.key',
      '*.pem',
      '*.ppk',
    ];

    foreach ($sensitive_patterns as $pattern) {
      $regex = str_replace('*', '.*', preg_quote($pattern, '/'));
      if (preg_match("/^{$regex}$/", $filename)) {
        return TRUE;
      }
    }

    return FALSE;
  }

  /**
   * Get type of sensitive config file.
   */
  private function getSensitiveConfigType(string $path): string {
    $filename = basename($path);

    if (preg_match('/settings\.(local\.)?php/', $filename)) {
      return 'drupal_config';
    }
    if (preg_match('/services\.yml/', $filename)) {
      return 'drupal_services';
    }
    if (preg_match('/\.env/', $filename)) {
      return 'environment_vars';
    }
    if (preg_match('/\.(key|pem|ppk)$/', $filename)) {
      return 'crypto_key';
    }

    return 'other_sensitive';
  }

  /**
   * Check if path is a private file.
   */
  private function isPrivateFile(string $path, string $private_path): bool {
    return !empty($private_path) && strpos($path, $private_path) === 0;
  }

  /**
   * Check if path is a public file (web/sites/*/files/).
   */
  private function isPublicFile(string $path): bool {
    return (bool) preg_match('#^web/sites/[^/]+/files/#', $path);
  }

  /**
   * Get Drupal private files stream path.
   */
  private function getPrivateFilesPath(): string {
    $private_path = \Drupal::getContainer()->getParameter('private_file_path');
    if ($private_path) {
      return str_replace($this->projectRoot . '/', '', $private_path);
    }
    return '';
  }

  /**
   * Recursively scan directory for all files.
   *
   * @param string $directory
   *   Directory to scan.
   *
   * @return array
   *   List of absolute file paths.
   */
  private function recursiveFileScan(string $directory): array {
    $files = [];
    $iterator = new \RecursiveIteratorIterator(
      new \RecursiveDirectoryIterator(
        $directory,
        \RecursiveDirectoryIterator::SKIP_DOTS
      ),
      \RecursiveIteratorIterator::LEAVES_ONLY
    );

    // Skip certain directories to improve performance
    $skip_dirs = ['.git', '.ddev', 'private', 'tmp'];

    foreach ($iterator as $file) {
      $path = $file->getRealPath();

      // Skip hidden directories
      if (preg_match('#/\.[a-zA-Z]#', $path)) {
        continue;
      }

      // Skip specific directories
      $skip = FALSE;
      foreach ($skip_dirs as $skip_dir) {
        if (strpos($path, '/' . $skip_dir . '/') !== FALSE) {
          $skip = TRUE;
          break;
        }
      }

      if (!$skip && is_file($path)) {
        $files[] = $path;
      }
    }

    return $files;
  }

  /**
   * Format bytes for human-readable display.
   */
  private function formatBytes(int $bytes): string {
    $units = ['B', 'KB', 'MB', 'GB'];
    $bytes = max($bytes, 0);
    $pow = floor(($bytes ? log($bytes) : 0) / log(1024));
    $pow = min($pow, count($units) - 1);
    $bytes /= (1 << (10 * $pow));

    return round($bytes, 2) . ' ' . $units[$pow];
  }

}
